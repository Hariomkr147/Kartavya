# Kartavya backend — copy to backend/.env and adjust. NEVER commit the real .env.
# Every variable here is read in app/settings.py; the table in
# docs/backend/architecture.md Part 13 is the reference.

# development | testing | production
KARTAVYA_ENV=development

# --- Persistence -------------------------------------------------------------
# SQLite is the default and is right for local work and CI. Nothing in the
# architecture assumes it: the enums render as CHECK constraints on both, the
# catch-all index declares sqlite_where AND postgresql_where, and the PRAGMAs
# below are skipped on any non-SQLite driver.
DATABASE_URL=sqlite:///instance/kartavya.sqlite3

# For a deployment where data must survive a restart, point this at a hosted
# Postgres instead (the deployed backend uses Neon). Paste the provider's
# string verbatim — app/settings.py rewrites `postgres://` and `postgresql://`
# to name the psycopg driver, because SQLAlchemy 2 dropped the first alias and
# the second selects psycopg2, which is not installed here.
#   DATABASE_URL=postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require
# Prefer the POOLED endpoint over the direct one: 8 gunicorn threads open more
# connections than a free direct endpoint is meant to hold.

# --- Secrets -----------------------------------------------------------------
# Both MUST be set outside development — app/settings.py fails fast at startup
# if they are missing, rather than silently signing with a dev default.
# They are deliberately two different secrets: leaking the photo key must not
# hand anyone the ability to mint an admin JWT.
JWT_SECRET=dev-only-jwt-secret-change-me
PHOTO_SIGNING_KEY=dev-only-photo-signing-key-change-me
JWT_TTL_HOURS=24
PHOTO_URL_TTL_SECONDS=86400

# --- Photo storage -----------------------------------------------------------
# Must sit OUTSIDE the web root; it is never served as a static directory.
UPLOAD_DIR=instance/uploads
MAX_UPLOAD_BYTES=5242880

# --- AI (both features fail soft; `null` exercises every fail-soft path) ------
# local | remote | stub | null
#   stub   canned, deterministic text - the right default for dev and CI
#   local  Ollama on AI_LOCAL_URL
#   remote any OpenAI-compatible chat-completions endpoint
#   null   every call returns None, exercising the fail-soft paths
AI_PROVIDER=stub
AI_TIMEOUT_SECONDS=10
AI_BREAKER_FAILURE_THRESHOLD=5
AI_BREAKER_COOLDOWN_SECONDS=120
AI_WORKER_THREADS=3
# Turn photo pre-screening off entirely without changing the provider.
AI_SCREENING_ENABLED=true

# Screening that never landed is otherwise permanent: an UNAVAILABLE row is
# never retried, and a PENDING row whose background task died with its process
# is never picked up again. The sweeper re-queues both. Also gated by
# AI_SCREENING_ENABLED.
AI_SCREENING_RETRY_MINUTES=10
# Bounded by age, not by a per-row attempt count — complaint_evidence has no
# attempts column. Past this, a row is never retried again.
AI_SCREENING_RETRY_WINDOW_HOURS=6
# Caps what one sweep can cost against a rate-limited provider.
AI_SCREENING_RETRY_BATCH=25
# How long a row may sit PENDING before it is assumed orphaned. Generous on
# purpose: staleness is measured from created_at, so a re-queued row still
# looks old, and a shorter value would double-queue anything waiting on the
# screening threads.
AI_SCREENING_STALE_PENDING_MINUTES=60

# To run the real thing locally, point `remote` at OpenRouter. The deployed
# backend uses exactly this (see render.yaml). The model must be VISION-capable
# or photo pre-screening degrades to UNAVAILABLE while zone reports still work.
# Raise the timeout: free-tier calls measured 4-9s, over the 10s default.
# NEVER commit a real key - .env is git-ignored, and on Render the key is set in
# the dashboard rather than in render.yaml.
#   AI_PROVIDER=remote
#   AI_API_URL=https://openrouter.ai/api/v1/chat/completions
#   AI_MODEL_NAME=google/gemma-4-26b-a4b-it:free
#   AI_API_KEY=sk-or-v1-...
#   AI_TIMEOUT_SECONDS=45

# --- Domain tuning -----------------------------------------------------------
CLUSTER_RADIUS_METERS=100
AUTO_CLOSE_SWEEP_MINUTES=15

# --- CORS --------------------------------------------------------------------
# The Vite dev server, so the finished frontend can run with VITE_USE_MOCKS=false.
CORS_ORIGINS=http://localhost:5173
