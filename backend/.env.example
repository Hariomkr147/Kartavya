# Kartavya backend — copy to backend/.env and adjust. NEVER commit the real .env.
# Every variable here is read in app/settings.py; the table in
# docs/backend/architecture.md Part 13 is the reference.

# development | testing | production
KARTAVYA_ENV=development

# --- Persistence -------------------------------------------------------------
# SQLite only for now. Nothing in the architecture assumes it; swapping to
# Postgres is a URL change plus more gunicorn workers.
DATABASE_URL=sqlite:///instance/kartavya.sqlite3

# --- Secrets -----------------------------------------------------------------
# Both MUST be set outside development — app/settings.py fails fast at startup
# if they are missing, rather than silently signing with a dev default.
# They are deliberately two different secrets: leaking the photo key must not
# hand anyone the ability to mint an admin JWT.
JWT_SECRET=dev-only-jwt-secret-change-me
PHOTO_SIGNING_KEY=dev-only-photo-signing-key-change-me
JWT_TTL_HOURS=24
PHOTO_URL_TTL_SECONDS=86400

# --- Photo storage -----------------------------------------------------------
# Must sit OUTSIDE the web root; it is never served as a static directory.
UPLOAD_DIR=instance/uploads
MAX_UPLOAD_BYTES=5242880

# --- AI (both features fail soft; `null` exercises every fail-soft path) ------
# local | stub | null
AI_PROVIDER=stub
AI_TIMEOUT_SECONDS=10
AI_BREAKER_FAILURE_THRESHOLD=5
AI_BREAKER_COOLDOWN_SECONDS=120
AI_WORKER_THREADS=3
# Turn photo pre-screening off entirely without changing the provider.
AI_SCREENING_ENABLED=true

# --- Domain tuning -----------------------------------------------------------
CLUSTER_RADIUS_METERS=100
AUTO_CLOSE_SWEEP_MINUTES=15

# --- CORS --------------------------------------------------------------------
# The Vite dev server, so the finished frontend can run with VITE_USE_MOCKS=false.
CORS_ORIGINS=http://localhost:5173
