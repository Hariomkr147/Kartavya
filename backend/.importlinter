; Enforces the dependency rule from docs/backend/architecture.md §3.3.
; Run with:  lint-imports --config .importlinter
;
; Without this in CI, app/domain/ acquires a db.session by week four and the
; fastest tests in the project stop being possible. That is a failing build.

[importlinter]
root_package = app
; Required because the pure-domain contract below names external packages
; (flask, sqlalchemy). Without it, `lint-imports` refuses to run at all.
include_external_packages = True

[importlinter:contract:layers]
name = Layered architecture
type = layers
layers =
    app.api
    app.services
    app.models
    app.domain

[importlinter:contract:pure-domain]
name = Domain is pure
type = forbidden
source_modules =
    app.domain
forbidden_modules =
    flask
    sqlalchemy
    app.models
    app.services
    app.api
    app.core
    app.infra

[importlinter:contract:serializers-do-not-query]
name = Serializers never touch the ORM session
type = forbidden
source_modules =
    app.api.shared.serializers
    app.api.citizen.serializers
    app.api.officer.serializers
    app.api.admin.serializers
forbidden_modules =
    app.extensions
    app.services
; A serializer naming a model type is fine and unavoidable; `app.models.base`
; is where the declarative base pulls in `db`. Without this the contract is
; unsatisfiable — every serializer reaches app.extensions transitively through
; the very type annotations it needs. What the rule is actually about is a
; serializer reaching for `db.session` itself, which is the direct edge.
ignore_imports =
    app.models.base -> app.extensions

[importlinter:contract:reporter-identity-is-admin-only]
name = Only the admin package may serialize reporter identity
type = forbidden
source_modules =
    app.api.citizen.serializers
    app.api.officer.serializers
    app.api.shared.serializers
forbidden_modules =
    app.api.admin.serializers
