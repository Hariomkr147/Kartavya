// ============================================================================
// Kartavya — Database Schema (v2)
// Civic grievance reporting platform
//
// Designed to back the Kartavya API contract (backend/api/openapi.yaml) one-to-one.
// Every field the API returns either maps to a column here or is cleanly
// derivable from these tables (counts, sums, ranks, SLA math).
//
// Design principles followed:
//   * Integrity at the DB layer: fixed value-sets use ENUMs, not free varchars,
//     so a typo'd status can never be stored. One-time facts use UNIQUE indexes.
//   * No stored-derived fields that can drift. Severity LABEL and SLA LABEL are
//     computed on read from severity_score and the SLA timestamps, so they can
//     never disagree with their source. (We store the SLA *inputs*, which are
//     point-in-time snapshots, never the *label*.)
//   * Append-only ledgers for anything historical (points, status changes) so
//     totals are always re-computable and nothing is silently overwritten.
//   * FK delete rules chosen per relationship (restrict for audit/financial
//     trails, set null for actor links, cascade for per-user artifacts), so the
//     "deactivate, don't delete" policy is safe and nothing is orphaned.
//   * Stack target: Flask + SQLAlchemy + SQLite. ENUMs and FK actions below all
//     translate to SQLite CHECK / FK clauses via SQLAlchemy.
// ============================================================================

Project kartavya {
  database_type: 'SQLite'
  Note: '''
    Kartavya v2 schema. Seed data required before use:
      * 12 complaint_categories (fixed list, with default sla_hours)
      * 6 badges (with criteria_type / criteria_value)
      * exactly 1 zones row flagged is_catch_all = true (the "Unassigned" fallback; enforced by a partial unique index and never deletable)
      * 1 app_settings row (id = 1)
      * admin user(s) (admins are seeded, never self-registered)
  '''
}

// ----------------------------------------------------------------------------
// ENUMS  (fixed value-sets — enforced by the DB, mirror the API enums)
// ----------------------------------------------------------------------------

Enum user_role {
  CITIZEN
  OFFICER
  ADMIN
}

Enum complaint_status {
  SUBMITTED              // just filed, waiting for an officer to open it
  EVIDENCE_UNDER_REVIEW  // officer is judging the photo
  NEEDS_MORE_EVIDENCE    // sent back to citizen, SLA timer paused here — reached either pre-acceptance (from EVIDENCE_UNDER_REVIEW) or as an officer's later recall of an already-accepted complaint (from UNDER_REVIEW)
  REJECTED               // turned down with a reason (terminal)
  UNDER_REVIEW           // accepted into the queue; SLA timer starts
  IN_PROGRESS            // officer has started
  UNDER_RESOLUTION       // officer actively fixing; progress notes allowed
  RESOLVED               // officer done; awaiting citizen confirmation
  CLOSED                 // citizen confirmed (terminal); points credited
  REOPENED               // citizen disputed (reason + fresh photo required); awaits an admin's dispute-review verdict — only that verdict can move it on, to IN_PROGRESS (upheld) or CLOSED (rejected, no points)
  UNRESOLVABLE           // structural blocker, reason required (terminal)
}

Enum severity_label {
  LOW       // score 0-4
  MEDIUM    // score 5-14
  HIGH      // score 15-29
  CRITICAL  // score 30+
}
// NOTE: severity_label is NOT stored on complaints — it is derived on read from
// complaints.severity_score using the ranges above. The enum exists so any
// stored or API-facing label is validated consistently.

Enum sla_label {
  ON_TIME   // < 80% of target consumed
  DELAYED   // 80-100% of target
  OVERDUE   // > 100% of target
}
// NOTE: sla_label is also derived on read (see the sla_* columns on complaints).

Enum evidence_verdict {
  VALID
  NEEDS_MORE_EVIDENCE
  REJECTED
}

Enum ai_screen_status {
  PENDING      // photo uploaded, AI has not finished yet
  DONE         // AI returned a result (see ai_confidence / ai_note)
  UNAVAILABLE  // AI service was down; treat the hint as absent
}

Enum status_actor {
  CITIZEN
  OFFICER
  ADMIN
  SYSTEM   // automated transitions, e.g. auto-close on timeout
}

Enum points_reason {
  COMPLAINT_CLOSED       // +50, first citizen in a cluster (or a standalone reporter) to confirm
  CLUSTER_MEMBER_CLOSED  // +10, other cluster members who confirm after the +50 is already granted; at most one cluster reward per citizen per cluster
  FIRST_COMPLAINT        // +10
  ON_TIME_BONUS          // +15
  UPVOTE_RECEIVED        // +5
  REJECTED_PENALTY       // -20
}

Enum badge_code {
  KARTAVYA_INITIATE
  STREET_GUARDIAN
  ZONE_CHAMPION
  CENTURY_REFORMER
  CIVIC_HERO
  SWIFT_REPORTER
}

Enum badge_criteria_type {
  FIRST_COMPLAINT       // award on first complaint filed
  COMPLAINTS_CLOSED     // award at criteria_value complaints closed (e.g. 5)
  LIFETIME_POINTS       // award at criteria_value lifetime CSP (e.g. 100, 500)
  ZONE_RANK_ONE         // award on reaching #1 on the zone leaderboard
  CLOSED_WITHIN_DAYS    // award at 3 closed within criteria_value days (e.g. 7)
}

Enum ai_report_status {
  PENDING
  READY
  FAILED
}

// ----------------------------------------------------------------------------
// ACCOUNTS & REFERENCE DATA
// ----------------------------------------------------------------------------

Table users {
  id            int            [pk, increment]
  full_name     varchar(120)   [not null, note: 'Real name. Never shown to other citizens or to officers.']
  display_name  varchar(60)    [note: 'Public handle for leaderboards. App falls back to a masked value if null.']
  email         varchar(255)   [unique, not null, note: 'Unique across ALL roles — this is what stops officers self-registering.']
  password_hash varchar(255)   [not null]
  role          user_role      [not null]
  zone_id       int            [note: 'Officer: assigned zone (exactly one). Citizen: home zone. Admin: null.']
  is_active     boolean        [not null, default: true, note: 'Soft-deactivate flag. Inactive users cannot log in. Preferred over deletion.']
  created_at    datetime       [not null, default: `now()`]

  indexes {
    role
    zone_id
  }

  Note: 'Maps to the API User schema. The officer\'s public ID (API officerId) is this id; full_name is never exposed publicly.'
}

Table zones {
  id           int          [pk, increment]
  zone_code    varchar(20)  [unique, not null, note: 'Immutable once created. Renaming changes zone_name only, never this code.']
  zone_name    varchar(120) [not null, note: 'Display name. This is the only field a rename may change.']
  center_lat   float        [not null, note: 'Zone centre. Routing uses NEAREST centroid — a location is assigned to the zone whose centre is closest. This always yields exactly one zone (no gaps, no overlaps).']
  center_lng   float        [not null]
  is_catch_all boolean      [not null, default: false, note: 'The "Unassigned" fallback zone. Exactly one row may have this true — enforce with a partial unique index (see note below). It cannot be deleted or unset.']
  is_active    boolean      [not null, default: true, note: 'Soft-deactivate flag. Prefer deactivating a zone over deleting it, mirroring users.is_active.']
  created_at   datetime     [not null, default: `now()`]

  indexes {
    // NOT a plain unique index: DBML has no partial-index syntax, and a plain
    // `unique` flag here would wrongly cap the table at one is_catch_all=false
    // row too (blocking every real zone but the first). The actual constraint
    // must be built directly as a partial index in the migration, not via a
    // declarative SQLAlchemy `unique=True` column constraint:
    //   CREATE UNIQUE INDEX ... ON zones(is_catch_all) WHERE is_catch_all = 1;
    (is_catch_all) [note: 'PARTIAL unique index (WHERE is_catch_all = true) — guarantees at most one catch-all zone exists. Must be created as a real partial index (e.g. SQLAlchemy Index(..., sqlite_where=...)), not a column-level unique constraint.']
  }

  Note: 'Admin-managed areas. A complaint\'s zone is pre-selected on the client (from photo EXIF GPS or manual pick) and confirmed by the citizen — the server does not silently auto-route. Zone assignment is snapshotted onto the complaint once and never recomputed, so moving or resizing a zone later cannot retroactively change old complaints.'
}

Table complaint_categories {
  id            int          [pk, increment]
  category_code varchar(40)  [unique, not null]
  category_name varchar(120) [unique, not null]
  description   text
  sla_hours     int          [not null, note: 'Current target resolution time (>= 1). Editable by admin; only affects complaints accepted afterwards.']
  created_at    datetime     [not null, default: `now()`]

  Note: 'The 12 fixed categories are seeded once. The list is not editable from the app; only sla_hours changes. GET /categories returns sla_hours as slaTargetHours.'
}

// ----------------------------------------------------------------------------
// COMPLAINTS  (the core record + its clusters)
// ----------------------------------------------------------------------------

Table complaint_clusters {
  id                    int      [pk, increment]
  category_id           int      [not null]
  zone_id               int      [not null]
  centroid_lat          float    [not null]
  centroid_lng          float    [not null]
  report_count          int      [not null, default: 1, note: 'Total complaints linked here (may include several from one citizen).']
  unique_reporter_count int      [not null, default: 1, note: 'Distinct citizens in the cluster. This — NOT report_count — drives severity, so one person cannot inflate urgency by filing the same issue repeatedly. Severity score = (unique_reporter_count - 1) * 3 + total upvotes.']
  reward_granted        boolean  [not null, default: false, note: 'True once the one-time +50 cluster-closed reward has been paid — to whichever member\'s confirm() was first to succeed, not necessarily the earliest reporter. Prevents the reward from firing twice, including after a later dispute-and-refix.']
  created_at            datetime [not null, default: `now()`]
  updated_at            datetime [not null, default: `now()`]

  indexes {
    (category_id, zone_id)
  }

  Note: '''
    Nearby same-category complaints (Haversine, ~50-100 m) are linked into one cluster. Replaces ML clustering, which is out of scope. Cluster lifecycle rules:
      * SEVERITY counts distinct citizens (unique_reporter_count), not raw rows.
      * RESOLUTION cascades: when the officer resolves the shared issue, every member that has passed evidence review and is not awaiting a dispute verdict (UNDER_REVIEW / IN_PROGRESS / UNDER_RESOLUTION) moves to RESOLVED together (SYSTEM-actor entries in status_history). Members are skipped, never forced: already-terminal (CLOSED / REJECTED / UNRESOLVABLE), already-RESOLVED, evidence-phase members (SUBMITTED / EVIDENCE_UNDER_REVIEW / NEEDS_MORE_EVIDENCE — the evidence gate is never bypassed by riding a cluster resolution), and REOPENED members (a pending dispute is never bypassed either — it keeps waiting for an explicit admin dispute-review verdict no matter what happens elsewhere in the cluster) keep their status.
      * CONFIRMATION is per-complaint: each citizen confirms or disputes their own.
      * DISPUTE reopens ONLY that member, and the member STAYS in the cluster — cluster_id is never cleared. Other members keep their own statuses (CLOSED stays CLOSED), so a cluster can hold members at mixed stages; cluster state is always derived from member statuses, never stored. A dispute requires both a reason and a fresh photo (appended to complaint_evidence) — the citizen carries the burden of proof. An admin, not the officer, then rules on it via the dispute-review verdict: upheld sends it back to IN_PROGRESS, rejected sends it straight to CLOSED with no points (same as an auto-close). A REOPENED member is excluded from the cascade above precisely so this verdict can never be preempted — a sibling resolving elsewhere in the cluster cannot sweep a pending dispute to RESOLVED before the admin rules on it.
      * REWARD is one-time per cluster (reward_granted): the +50 COMPLAINT_CLOSED bonus goes to whichever member's confirm() is first to succeed — first-to-confirm, not first-to-report. Every other member who later confirms their own complaint gets +10 CLUSTER_MEMBER_CLOSED instead. Cluster rewards are also paid at most once per CITIZEN per cluster: a citizen who filed several member complaints is paid only on their first successful confirm — confirming their remaining duplicates closes them with no points, so duplicate filing cannot farm rewards. Never re-fired by a later dispute/refix (membership is permanent, so a disputed-and-refixed member can never masquerade as a standalone +50).
      * ON_TIME_BONUS is independent of the cluster reward — each complaint carries its own sla_target_hours/sla_started_at snapshot, so a member who only gets CLUSTER_MEMBER_CLOSED can still separately earn +15 if their own complaint met its own SLA.
  '''
}

Table complaints {
  id                   int               [pk, increment]
  complaint_code       varchar(30)       [unique, not null, note: 'Human-friendly id, e.g. KTV-2026-000123.']
  citizen_id           int               [not null, note: 'Reporter. Hidden from officers and from the public feed.']
  zone_id              int               [not null, note: 'Snapshotted from the citizen-confirmed zone at submit time; never recomputed. Can be admin-overridden. Because it is a snapshot, later zone moves/renames cannot alter old complaints.']
  category_id          int               [not null]
  cluster_id           int               [note: 'Set if linked to nearby duplicates. Never cleared by a dispute — membership is permanent, so a disputed-and-refixed member still counts as part of its cluster when the one-time +50 reward guard is checked.']
  assigned_officer_id  int               [note: 'Current handling officer (API assignedOfficerId). Null until an officer picks it up via POST /officer/complaints/{id}/claim — the only door for SUBMITTED -> EVIDENCE_UNDER_REVIEW, which sets this in the same step. Also cleared back to null (app logic, not an FK delete rule) on every one of this officer\'s non-terminal complaints when they are reassigned to a different zone — otherwise the complaint would stay "assigned" to someone who can no longer see it, since officer visibility is zone-scoped.']

  description          text              [note: 'Optional — a citizen may pick a category manually without typing. Matches the API (description not required).']
  latitude             float             [not null]
  longitude            float             [not null]

  status               complaint_status  [not null, default: 'SUBMITTED']
  severity_score       int               [not null, default: 0, note: 'Derived and cached: (cluster unique_reporter_count - 1) * 3 + upvote count. Counts DISTINCT citizens, not raw complaints, so one person filing repeatedly cannot inflate it. The severity LABEL is computed from this on read, never stored.']

  // --- SLA inputs (snapshots) — the label is computed from these, not stored ---
  sla_target_hours     int               [note: 'Snapshot of the category SLA at acceptance. Frozen, so later SLA edits do not move this complaint. Also backfilled by an admin override that force-jumps straight to UNDER_REVIEW or later, if still unset.']
  sla_started_at       datetime          [note: 'When it entered UNDER_REVIEW (the timer start). Null before acceptance. Also backfilled to now by an admin override that force-jumps straight to UNDER_REVIEW or later, so slaLabel never silently comes back null for an overridden complaint.']
  sla_paused_seconds   int               [not null, default: 0, note: 'Accumulated time spent waiting on the citizen while in NEEDS_MORE_EVIDENCE, excluded from SLA. Only accrues once sla_started_at is set — an officer recalling an UNDER_REVIEW complaint (PATCH .../status -> NEEDS_MORE_EVIDENCE, reason required) pauses a running clock; the original pre-acceptance NEEDS_MORE_EVIDENCE loop is a no-op here since the timer has not started yet.']
  sla_paused_at        datetime          [note: 'Set when the timer pauses; non-null means currently paused. Cleared into sla_paused_seconds on resume (when the complaint leaves NEEDS_MORE_EVIDENCE back to EVIDENCE_UNDER_REVIEW).']

  created_at           datetime          [not null, default: `now()`]
  updated_at           datetime          [not null, default: `now()`, note: 'App refreshes this on every change.']
  resolved_at          datetime          [note: 'Set when officer marks RESOLVED.']
  closed_at            datetime          [note: 'Set when the complaint reaches CLOSED.']

  indexes {
    (zone_id, status)        // officer queue
    citizen_id               // GET /complaints/my
    category_id
    cluster_id
    assigned_officer_id
    status
  }

  Note: 'Central record. Backs Complaint / ComplaintDetail. severityLabel and slaLabel are computed at serialization time from severity_score and the sla_* columns.'
}

Table complaint_evidence {
  id                  int              [pk, increment]
  complaint_id        int              [not null]
  sequence            int              [not null, note: '1..N = original photos submitted at filing time (up to 3), N+1 onward = re-submissions or dispute evidence (POST /complaints/{id}/dispute also appends here). All rows are retained.']
  file_path           text             [not null, note: 'Path on the local filesystem (photos are not stored in the DB).']

  // AI photo pre-screening (asynchronous, advisory only)
  ai_screen_status    ai_screen_status [not null, default: 'PENDING', note: 'PENDING/DONE/UNAVAILABLE — lets the UI tell "no result yet" apart from "AI was down".']
  ai_matches_category boolean          [note: 'AI guess: does the photo match the chosen category?']
  ai_confidence       float            [note: '0..1 confidence from the vision model.']
  ai_note             text             [note: 'Short plain-language hint shown to the officer.']

  // Officer verdict
  verdict             evidence_verdict [note: 'Null until reviewed. VALID / NEEDS_MORE_EVIDENCE / REJECTED. REJECTED is only legal on a complaint\'s first evidence round (before sla_started_at is set) — a re-review triggered by an officer\'s later NEEDS_MORE_EVIDENCE recall of an already-accepted complaint can only resolve VALID or NEEDS_MORE_EVIDENCE again. Permanently null for a dispute-evidence row (submitted with the complaint already RESOLVED) — that photo is never routed through an officer\'s evidence-review verdict; the admin judges it directly when ruling on the dispute, and that ruling lives on status_history, not here.']
  verdict_reason      text             [note: 'App-enforced as mandatory for NEEDS_MORE_EVIDENCE and REJECTED.']
  reviewed_by         int              [note: 'Officer who gave the verdict.']
  reviewed_at         datetime

  created_at          datetime         [not null, default: `now()`]

  indexes {
    complaint_id
    (complaint_id, sequence) [unique]
  }

  Note: 'One row per uploaded photo. Backs the Evidence schema, including the AiConfidenceNote (aiAvailable = ai_screen_status != UNAVAILABLE).'
}

Table status_history {
  id                int              [pk, increment]
  complaint_id      int              [not null]
  from_status       complaint_status [note: 'Null for the very first entry.']
  to_status         complaint_status [not null]
  actor_role        status_actor     [not null, note: 'CITIZEN / OFFICER / ADMIN / SYSTEM. Maps to the API StatusActor enum on StatusHistoryEntry.changedByRole — a separate, 4-value enum from the 3-value Role used on User accounts, since SYSTEM is never a valid account role.']
  changed_by_user_id int             [note: 'The acting user. Null when actor_role = SYSTEM (e.g. auto-close). FK is RESTRICT on delete — an officer/admin who has ever changed a complaint\'s status cannot be hard-deleted, protecting this audit trail the same way complaint_notes.officer_id protects note attribution.']
  reason            text             [note: 'Carries reject / unresolvable / dispute / dispute-review / override reasons.']
  remark            text             [note: 'Optional free-text remark, e.g. the officer\'s closing note when marking RESOLVED. Distinct from reason.']
  created_at        datetime         [not null, default: `now()`]

  indexes {
    (complaint_id, created_at)
  }

  Note: 'Append-only audit trail. Every stage change is one row. Backs StatusHistoryEntry (reason + remark map 1:1; changedByOfficerId = changed_by_user_id when actor_role = OFFICER).'
}

Table complaint_notes {
  id           int          [pk, increment]
  complaint_id int          [not null]
  officer_id   int          [not null, note: 'Notes are officer-authored only (US-O03). Shown to the citizen with the officer ID, not the name.']
  note_text    varchar(500) [not null, note: 'Up to 500 characters. Permanent — never edited or deleted.']
  created_at   datetime     [not null, default: `now()`]

  indexes {
    (complaint_id, created_at)
  }

  Note: 'Progress notes. Backs ProgressNote.'
}

Table complaint_upvotes {
  id           int      [pk, increment]
  complaint_id int      [not null]
  citizen_id   int      [not null, note: 'App also enforces citizen_id != complaint.citizen_id (no self-upvotes).']
  created_at   datetime [not null, default: `now()`]

  indexes {
    (complaint_id, citizen_id) [unique, note: 'One upvote per citizen per complaint.']
  }

  Note: 'Upvotes feed both severity (each upvote +1 to the score) and the reporter\'s CSP (+5). upvoteCount = COUNT(*) per complaint.'
}

// ----------------------------------------------------------------------------
// GAMIFICATION
// ----------------------------------------------------------------------------

Table points_ledger {
  id            int           [pk, increment]
  citizen_id    int           [not null]
  complaint_id  int           [note: 'The complaint that triggered this change, if any.']
  points_change int           [not null, note: 'Signed: +50, +10, +15, +5, or -20.']
  reason        points_reason [not null]
  created_at    datetime      [not null, default: `now()`]

  indexes {
    (citizen_id, created_at)
  }

  Note: 'Append-only CSP ledger. Lifetime total = SUM(points_change); monthly total = SUM where created_at in the month. No stored total, so nothing can drift. Clustered complaints: the +50 COMPLAINT_CLOSED reward is paid ONCE per cluster (guarded by complaint_clusters.reward_granted, an atomic test-and-set inside the same transaction as the CLOSED write) to whichever member confirms first; every other member who later confirms gets +10 CLUSTER_MEMBER_CLOSED instead — never the full +50 twice, never re-fired by a later dispute/refix (dispute does not detach the member), and paid at most once per citizen per cluster: confirming your own additional duplicates closes them but credits nothing. Auto-close on timeout credits no points at all — rewards flow only through an explicit confirm. A REOPENED complaint that an admin rejects (dispute-review verdict REJECTED) also credits no points on its way to CLOSED, same as an auto-close — a citizen cannot use a losing dispute to manufacture a second shot at the reward they gave up by disputing instead of confirming. ON_TIME_BONUS is unaffected by this and is evaluated per-complaint for every member independently.'
}

Table badges {
  id             int                 [pk, increment]
  badge_code     badge_code          [unique, not null]
  badge_name     varchar(80)         [not null]
  description    text
  criteria_type  badge_criteria_type [not null, note: 'How the badge is earned — makes award logic data-driven instead of points-only.']
  criteria_value int                 [note: 'The threshold, where the type needs one (5, 100, 500, 7...). For CLOSED_WITHIN_DAYS this is the day-window (see criteria_count for the count). Null for FIRST_COMPLAINT and ZONE_RANK_ONE.']
  criteria_count int                 [note: 'Only used by CLOSED_WITHIN_DAYS — the number of closures required within criteria_value days (e.g. 3). Null for every other criteria_type. Without this, CLOSED_WITHIN_DAYS could not be genuinely data-driven: the count would have to be a hardcoded constant in application code, contradicting the point of this table.']
  created_at     datetime            [not null, default: `now()`]

  Note: 'Catalog of the 6 badges, seeded once. Covers all charter triggers, not just point thresholds.'
}

Table citizen_badges {
  id         int      [pk, increment]
  citizen_id int      [not null]
  badge_id   int      [not null]
  earned_at  datetime [not null, default: `now()`]

  indexes {
    (citizen_id, badge_id) [unique, note: 'A badge is awarded at most once per citizen (US-C10).']
  }

  Note: 'Which citizen earned which badge, and when. Backs the Badge schema (earnedAt).'
}

// ----------------------------------------------------------------------------
// AI REPORTS & SYSTEM CONFIG
// ----------------------------------------------------------------------------

Table ai_zone_reports {
  id           int              [pk, increment]
  zone_id      int              [not null]
  requested_by int              [note: 'Admin who triggered it.']
  status       ai_report_status [not null, default: 'PENDING', note: 'PENDING right after POST, READY when done, FAILED if AI was unavailable.']
  ai_available boolean          [not null, default: true]
  summary      text
  trends       text
  hotspots     text
  suggestions  text
  generated_at datetime         [note: 'Set when status becomes READY or FAILED.']
  created_at   datetime         [not null, default: `now()`]

  indexes {
    (zone_id, created_at)
  }

  Note: 'Persists AI zone health reports so they can be re-viewed without regenerating. GET /admin/zones/{zoneId}/ai-report returns the latest row for the zone.'
}

Table app_settings {
  id                      int      [pk, note: 'Single-row table; always id = 1.']
  auto_close_timeout_hours int     [not null, default: 168, note: 'How long a RESOLVED complaint waits for citizen confirmation before auto-closing. An auto-close credits no points — the confirm rewards require an explicit citizen confirm.']
  updated_by              int      [note: 'Admin who last changed settings.']
  updated_at              datetime [not null, default: `now()`]

  Note: 'Backs GET / PATCH /admin/settings. Holds the admin-configurable auto-close timeout.'
}

// ============================================================================
// RELATIONSHIPS  (with delete rules)
//   restrict  = block deletion while children exist (protect audit/financial trails)
//   set null  = keep the row, drop the link (actor references)
//   cascade   = remove dependent rows with the parent (per-user artifacts, complaint children)
// ============================================================================

// users / zones
Ref: users.zone_id > zones.id [delete: restrict]

// complaints
Ref: complaints.citizen_id          > users.id                 [delete: restrict]
Ref: complaints.zone_id             > zones.id                 [delete: restrict]
Ref: complaints.category_id         > complaint_categories.id  [delete: restrict]
Ref: complaints.cluster_id          > complaint_clusters.id    [delete: set null]
Ref: complaints.assigned_officer_id > users.id                 [delete: set null]

// clusters
Ref: complaint_clusters.category_id > complaint_categories.id  [delete: restrict]
Ref: complaint_clusters.zone_id     > zones.id                 [delete: restrict]

// evidence
Ref: complaint_evidence.complaint_id > complaints.id           [delete: cascade]
Ref: complaint_evidence.reviewed_by  > users.id                [delete: set null]

// status history
Ref: status_history.complaint_id       > complaints.id         [delete: cascade]
Ref: status_history.changed_by_user_id > users.id              [delete: restrict]

// notes
Ref: complaint_notes.complaint_id > complaints.id              [delete: cascade]
Ref: complaint_notes.officer_id   > users.id                  [delete: restrict]

// upvotes
Ref: complaint_upvotes.complaint_id > complaints.id            [delete: cascade]
Ref: complaint_upvotes.citizen_id   > users.id                 [delete: cascade]

// points ledger
Ref: points_ledger.citizen_id   > users.id                     [delete: restrict]
Ref: points_ledger.complaint_id > complaints.id                [delete: set null]

// badges
Ref: citizen_badges.citizen_id > users.id                      [delete: cascade]
Ref: citizen_badges.badge_id   > badges.id                     [delete: restrict]

// ai reports & settings
Ref: ai_zone_reports.zone_id      > zones.id                   [delete: cascade]
Ref: ai_zone_reports.requested_by > users.id                   [delete: set null]
Ref: app_settings.updated_by      > users.id                   [delete: set null]

// ----------------------------------------------------------------------------
// TABLE GROUPS (for diagram readability)
// ----------------------------------------------------------------------------
TableGroup accounts {
  users
  zones
  complaint_categories
}

