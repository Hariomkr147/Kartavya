# Loaded automatically by Vite in `npm run dev`. No secrets belong here.

# Whether the app talks to the MSW mock layer (frontend/src/mocks) instead of
# a real backend. The real backend doesn't exist yet, so this stays true
# until a stage explicitly points the app at a live API.
VITE_USE_MOCKS=true

# Base URL every services/* client prefixes its requests with. Matches the
# `/api/v1` server path documented in backend/api/openapi.yaml.
VITE_API_BASE_URL=/api/v1
