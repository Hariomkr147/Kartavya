# Copy to .env.local to override the defaults in .env.development, e.g. to
# point at a real backend once one exists (.env.local is git-ignored).

VITE_USE_MOCKS=true
VITE_API_BASE_URL=/api/v1

# "Sign in with Google". Unset = no Google button and no Google script is ever
# loaded (mock mode and tests leave it unset). Public OAuth client id; the same
# value as the backend's GOOGLE_CLIENT_ID. Set it in .env.local for dev and in the
# Vercel project settings for deploys.
# VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
