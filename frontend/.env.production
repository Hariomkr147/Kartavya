# Loaded by Vite for `npm run build` (and therefore by Vercel). Committed on
# purpose: neither value is a secret, and keeping them here means a local
# production build behaves exactly like the deployed one. Environment
# variables set in the Vercel dashboard override this file.

# Mocks must never ship to a deployed build. main.tsx only starts MSW when this
# is exactly "true", so the mock layer stays out of the bundle here.
VITE_USE_MOCKS=false

# Absolute, because the SPA and the API are on different hosts. Relative
# "/api/v1" would resolve against the Vercel domain, which serves no API.
# The backend must list the Vercel origin in CORS_ORIGINS - see render.yaml.
VITE_API_BASE_URL=https://kartavya-backend-zkxz.onrender.com/api/v1
